graph TD
    subgraph "External World"
        Browser["User Browser / Player"]
        Frontend["Next.js Frontend Proxy (:3000)"]
        Backend["Go Main Backend (:8080)"]
    end

    subgraph "Media Server Architecture (:8081)"
        subgraph "API Layer (Echo Framework)"
            Router["Echo Router"]
            AuthMW["API Key Auth Middleware"]
            HLSHandler["Stream Handler (HLS)"]
            FileHandler["File Handler (Upload/Manage)"]
        end

        subgraph "Logic Layer (Services)"
            MinioSvc["Minio Service"]
            TranscodeSvc["Transcoding Service"]
            TaskProc["Task Processor (Asynq)"]
        end

        subgraph "Infrastructure & Storage"
            Redis[("Redis (Task Queue)")]
            FFmpeg["FFmpeg (HLS Engine)"]
            Minio[("Minio Object Storage")]
            LocalTmp["/tmp (Workspace)"]
        end
    end

    %% Networking & Proxy
    Browser -- "HTTPS /media-api/*" --> Frontend
    Frontend -- "HTTP /api/v1/*" --> Router
    Backend -- "HTTP /api/v1/* (X-API-KEY)" --> Router

    %% Routing
    Router --> AuthMW
    AuthMW --> FileHandler
    Router -- "Wildcard /stream/*" --> HLSHandler

    %% File Management Flow
    FileHandler -- "Upload/Download/Presign" --> MinioSvc
    FileHandler -- "Trigger Transcode" --> TaskProc
    MinioSvc -- "S3 API" --> Minio

    %% Transcoding Pipeline (Async)
    TaskProc -- "Enqueue Task" --> Redis
    Redis -- "Worker Pull" --> TaskProc
    TaskProc -- "Execute" --> TranscodeSvc
    TranscodeSvc -- "Download Raw" --> MinioSvc
    TranscodeSvc -- "Stage Files" --> LocalTmp
    TranscodeSvc -- "Spawn Process" --> FFmpeg
    FFmpeg -- "Read/Write" --> LocalTmp
    TranscodeSvc -- "Upload HLS Segments" --> MinioSvc

    %% Streaming Flow
    HLSHandler -- "Validate Token/Cookie" --> SecurityLogic["HMAC Security Logic"]
    HLSHandler -- "Set Session Cookie" --> Browser
    HLSHandler -- "Fetch Objects" --> TranscodeSvc
    TranscodeSvc -- "Get manifest/ts/key" --> MinioSvc

    %% Detailed HLS Steps
    subgraph "HLS Secure Pipeline"
        Step1["1. Manifest Request + Token"]
        Step2["2. Validate HMAC Signature"]
        Step3["3. Set stream_token Cookie"]
        Step4["4. Player fetches segments (auto-cookie)"]
        Step5["5. Key Request (relative path)"]
        
        Step1 --> Step2 --> Step3 --> Step4 --> Step5
    end

    classDef infrastructure fill:#f9f,stroke:#333,stroke-width:2px;
    classDef logic fill:#bbf,stroke:#333,stroke-width:2px;
    classDef storage fill:#bfb,stroke:#333,stroke-width:2px;
    
    class Redis,Minio,FFmpeg infrastructure;
    class MinioSvc,TranscodeSvc,TaskProc logic;
    class LocalTmp storage;
