# Server Configuration
PORT=8080
ENV=development

# Database Configuration
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=course_platform
# Use 'localhost' instead of 'db' when running locally with 'air'.
# Docker Compose will override this to 'db' for the containerized API.
DB_URL=postgres://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?sslmode=disable

# Redis Configuration
# Use 'localhost' when running locally.
# Docker Compose will override this to 'redis'.
REDIS_URL=localhost:6379

# JWT Configuration
JWT_SECRET=your_secret_key_here
JWT_EXPIRATION_HOURS=24

# Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Media Server Configuration
MEDIA_SERVER_URL=http://localhost:8081/api/v1
MEDIA_SERVER_API_KEY=secret-api-key

# Minio Configuration
# Use 'localhost:9000' for local dev.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_TEMP=temp-imports

# SSLCommerz Sandbox Credentials
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_SANDBOX=true

# Callback URL on the Backend API (called by SSLCommerz)
SSLCOMMERZ_SUCCESS_URL=http://localhost:8080/api/v1/payments/sslcommerz/success
SSLCOMMERZ_FAIL_URL=http://localhost:8080/api/v1/payments/sslcommerz/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:8080/api/v1/payments/sslcommerz/cancel
SSLCOMMERZ_IPN_URL=http://localhost:8080/api/v1/payments/sslcommerz/ipn

# Frontend redirect host
FRONTEND_URL=http://localhost:3000
