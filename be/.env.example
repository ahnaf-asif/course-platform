# Server Configuration
PORT=8080
ENV=development

# Database Configuration
# Use 'db' instead of 'localhost' when running inside Docker
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=course_platform
DB_URL=postgres://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}?sslmode=disable

# Redis Configuration
# Use 'redis' instead of 'localhost' when running inside Docker
REDIS_URL=redis:6379

# JWT Configuration
JWT_SECRET=your_secret_key_here
JWT_EXPIRATION_HOURS=24

# Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
