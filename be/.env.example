# Server Configuration
PORT=8080
ENV=development

# Database Configuration
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=course_platform
# Use 'localhost' instead of 'db' when running locally with 'air'.
# Docker Compose will override this to 'db' for the containerized API.
DB_URL=postgres://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?sslmode=disable

# Redis Configuration
# Use 'localhost' when running locally.
# Docker Compose will override this to 'redis'.
REDIS_URL=localhost:6379

# JWT Configuration
JWT_SECRET=your_secret_key_here
JWT_EXPIRATION_HOURS=24

# Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Media Server Configuration
MEDIA_SERVER_URL=http://localhost:8081/api/v1
MEDIA_SERVER_API_KEY=secret-api-key
